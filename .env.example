# Hedera
HEDERA_NETWORK=testnet
HEDERA_MIRROR_NODE=https://testnet.mirrornode.hedera.com/api/v1/
HEDERA_RPC_NODE=https://<your-hedera-testnet-json-rpc-url>

# Admin account (signs mint/freeze/wipe)
MY_ACCOUNT_ID=0.0.xxxxxxx
MY_PRIVATE_KEY=<admin-private-key>
MY_PRIVATE_KEY_TYPE=ECDSA

# Stablecoin studio
FACTORY_ADDRESS=0.0.xxxxxxx
RESOLVER_ADDRESS=0.0.xxxxxxx

# ATTN token
ATTN_TOKEN_ID=0.0.xxxxxxx
ATTN_PROXY_ID=0.0.xxxxxxx
ATTN_RESERVE_ID=0.0.xxxxxxx
ATTN_DECIMALS=6

# Test (user) account
TEST_ACCOUNT_ID=0.0.xxxxxxx
TEST_PRIVATE_KEY=<test-private-key>

# Hedera testnet USDC (Circle)
USDC_TOKEN_ID=0.0.429274

# 0G router (deski-backend /tool)
OG_BASE_URL=https://router-api.0g.ai/v1
OG_API_KEY=sk-...
# ENS subgraph on The Graph (ens tool). Free key from https://thegraph.com/studio
ENS_SUBGRAPH_URL=
# 0G Storage (logs every /tool call). Fund the wallet from the 0G testnet faucet
OG_STORAGE_PRIVATE_KEY=
OG_STORAGE_RPC=
OG_STORAGE_INDEXER=
